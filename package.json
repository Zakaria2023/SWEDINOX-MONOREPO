{
  "name": "swedinox-monorepo",
  "private": true,
  "scripts": {
    "dev": "turbo run dev --filter=@swedinox/dashboard",
    "build": "turbo run build --filter=@swedinox/dashboard",
    "lint": "turbo run lint --filter=@swedinox/dashboard",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md,css}\" --ignore-path .gitignore",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md,css}\" --ignore-path .gitignore",
    "clean": "turbo run clean && rm -rf node_modules",
    "db:push": "pnpm --filter @swedinox/dashboard db:push",
    "db:generate": "pnpm --filter @swedinox/dashboard db:generate",
    "db:migrate": "pnpm --filter @swedinox/dashboard db:migrate",
    "db:studio": "pnpm --filter @swedinox/dashboard db:studio"
  },
  "devDependencies": {
    "prettier": "^3.3.3",
    "turbo": "^2.3.3",
    "typescript": "^5.6.3"
  },
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  }
}
