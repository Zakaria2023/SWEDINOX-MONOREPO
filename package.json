{
  "name": "swedinox-monorepo",
  "private": true,
  "scripts": {
    "dev": "turbo run dev",
    "dev:dashboard": "turbo run dev --filter=@swedinox/dashboard",
    "dev:marketing": "turbo run dev --filter=@swedinox/marketing",
    "build": "turbo run build",
    "build:dashboard": "turbo run build --filter=@swedinox/dashboard",
    "build:marketing": "turbo run build --filter=@swedinox/marketing",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md,css}\" --ignore-path .gitignore",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md,css}\" --ignore-path .gitignore",
    "clean": "turbo run clean && rm -rf node_modules"
  },
  "devDependencies": {
    "prettier": "^3.3.3",
    "turbo": "^2.3.3",
    "typescript": "^5.6.3"
  },
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  }
}
