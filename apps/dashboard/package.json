{
  "name": "@swedinox/dashboard",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --port 3000",
    "build": "next build",
    "start": "next start --port 3000",
    "lint": "eslint .",
    "i18n:audit": "node i18n-audit.mjs",
    "verify-logistics": "node scripts/run-ts.mjs scripts/verify-logistics.ts",
    "verify-paging": "dotenv -e .env.local -- node scripts/run-ts.mjs scripts/verify-paging.mts",
    "clean": "node -e \"const fs=require('fs');for(const d of ['.next','.turbo'])fs.rmSync(d,{recursive:true,force:true})\"",
    "email:dev": "email dev --dir src/emails --port 3001",
    "db:push": "dotenv -e .env.local -- drizzle-kit push",
    "db:generate": "dotenv -e .env.local -- drizzle-kit generate",
    "db:migrate": "dotenv -e .env.local -- drizzle-kit migrate",
    "db:studio": "dotenv -e .env.local -- drizzle-kit studio"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1073.0",
    "@aws-sdk/s3-request-presigner": "^3.1073.0",
    "@base-ui/react": "^1.5.0",
    "@clerk/nextjs": "^7.4.3",
    "@clerk/shared": "4.15.0",
    "@clerk/localizations": "4.7.1",
    "@hookform/resolvers": "^5.4.0",
    "@react-email/components": "^1.0.12",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.44.0",
    "i18next": "^26.3.1",
    "i18next-resources-to-backend": "^1.2.1",
    "exceljs": "^4.4.0",
    "lucide-react": "^1.17.0",
    "mysql2": "^3.14.0",
    "next": "^16.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-hook-form": "^7.78.0",
    "react-i18next": "^17.0.8",
    "react-loading-skeleton": "^3.5.0",
    "resend": "^6.17.2",
    "shadcn": "^4.10.0",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@react-email/ui": "^6.8.1",
    "@tailwindcss/postcss": "^4.3.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "dotenv-cli": "^11.0.0",
    "drizzle-kit": "^0.31.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "^16.0.0",
    "jiti": "^2.7.0",
    "postcss": "^8.5.15",
    "react-email": "^6.8.1",
    "tailwindcss": "^4.3.0",
    "typescript": "^5.6.3"
  }
}
