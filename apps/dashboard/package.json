{
  "name": "@swedinox/dashboard",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --port 3000",
    "build": "next build",
    "start": "next start --port 3000",
    "lint": "next lint",
    "clean": "rm -rf .next .turbo",
    "db:push": "dotenv -e .env.local -- drizzle-kit push",
